# Copiez ce fichier vers .env (jamais commité, il est dans .gitignore).

# Obligatoire : clé de session Flask. Générez-en une avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi-avec-une-vraie-cle-aleatoire

# Comptes autorisés à se connecter à l'application, format "user:motdepasse"
# séparés par des virgules. Créés automatiquement au démarrage s'ils
# n'existent pas déjà (mot de passe haché en base, jamais stocké en clair).
# Ne mettez JAMAIS de vrais identifiants ici dans un fichier commité —
# ce fichier .env.example ne doit contenir que des valeurs d'exemple.
AUTH_USERS=salomon:motdepasse-a-changer,collegue:autre-motdepasse
