# Copiez ce fichier vers .env (jamais commité, il est dans .gitignore).

# Obligatoire : clé de session Flask. Générez-en une avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-moi-avec-une-vraie-cle-aleatoire

# Comptes autorisés à se connecter à l'application, format
# "user:motdepasse" ou "user:motdepasse:ROLE" (ROLE = AGENT ou ADMIN),
# séparés par des virgules. Créés/resynchronisés automatiquement au
# démarrage (mot de passe haché en base, jamais stocké en clair). Le rôle
# n'est appliqué que s'il est explicitement précisé — sinon un admin promu
# depuis le panneau d'administration n'est jamais rétrogradé au redémarrage.
# Ne mettez JAMAIS de vrais identifiants ici dans un fichier commité —
# ce fichier .env.example ne doit contenir que des valeurs d'exemple.
# Prévoyez au moins un compte :ADMIN pour accéder au panneau d'administration.
AUTH_USERS=salomon:motdepasse-a-changer:ADMIN,collegue:autre-motdepasse

# Optionnel : "1" pour activer le débogueur interactif Werkzeug en local
# (python app.py uniquement). Ne JAMAIS activer en production.
FLASK_DEBUG=0

# Optionnel : "1" pour marquer le cookie de session comme Secure
# (HTTPS uniquement). À activer une fois le domaine de production confirmé
# en HTTPS. Laisser à 0 en local (http://localhost), sinon la session ne
# fonctionnera plus.
FORCE_SECURE_COOKIES=0
