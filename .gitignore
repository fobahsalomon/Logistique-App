# Python / Flask
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.venv/
venv/
ENV/
env/

# Environment files
.env
.env.*
!.env.example

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary and generated files
*.log
*.tmp
*.temp
*.bak
*.orig
coverage.xml
htmlcov/
site/
build/
dist/
node_modules/

# Deployment / runtime artifacts
*.pid
*.sqlite3
*.db-journal

# Local project artifacts
/.cache/
/.pytest_cache/

# Base de données SQLite locale/prod : générée automatiquement au démarrage
# par core/db.py:init_db(), ne doit jamais être versionnée (évite d'écraser
# les données de prod ou de créer des conflits de merge sur un fichier binaire)
data/*.db
data/*.sqlite*
